{
  "name": "@arraypress/waveform-sounds",
  "version": "2.0.0",
  "description": "Searchable, filterable sound list for WaveformPlayer: audition hundreds of sample previews with inline waveforms, keyboard navigation and one shared audio engine.",
  "type": "module",
  "main": "dist/waveform-sounds.esm.js",
  "unpkg": "dist/waveform-sounds.min.js",
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./dist/waveform-sounds.esm.js",
      "default": "./dist/waveform-sounds.esm.js"
    },
    "./no-autoinit": {
      "types": "./types/entry.d.ts",
      "import": "./dist/waveform-sounds-no-autoinit.esm.js",
      "default": "./dist/waveform-sounds-no-autoinit.esm.js"
    },
    "./render": {
      "types": "./types/render-entry.d.ts",
      "import": "./dist/waveform-sounds-render.esm.js",
      "default": "./dist/waveform-sounds-render.esm.js"
    },
    "./styles.css": "./dist/waveform-sounds.css",
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist/",
    "src/",
    "types/",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "*.css",
    "./dist/waveform-sounds.esm.js",
    "./dist/waveform-sounds-no-autoinit.esm.js",
    "./dist/waveform-sounds.js",
    "./dist/waveform-sounds.min.js",
    "./src/js/index.ts",
    "./src/js/entry.ts"
  ],
  "scripts": {
    "build": "npm run build:css && npm run build:iife && npm run build:min && npm run build:esm && npm run build:no-autoinit && npm run build:render && npm run build:types",
    "build:css": "cp src/css/waveform-sounds.css dist/waveform-sounds.css && esbuild src/css/waveform-sounds.css --minify --outfile=dist/waveform-sounds.min.css",
    "build:iife": "esbuild src/js/index.ts --bundle --format=iife --outfile=dist/waveform-sounds.js",
    "build:min": "esbuild src/js/index.ts --bundle --format=iife --minify --outfile=dist/waveform-sounds.min.js",
    "build:esm": "esbuild src/js/index.ts --bundle --format=esm --outfile=dist/waveform-sounds.esm.js",
    "build:no-autoinit": "esbuild src/js/entry.ts --bundle --format=esm --outfile=dist/waveform-sounds-no-autoinit.esm.js",
    "build:render": "esbuild src/js/render-entry.ts --bundle --format=esm --outfile=dist/waveform-sounds-render.esm.js",
    "build:types": "rm -rf types && tsc -p tsconfig.build.json && node scripts/inline-text-types.mjs",
    "dev": "esbuild src/js/index.ts --bundle --format=iife --outfile=dist/waveform-sounds.js --watch",
    "size": "npm run build && echo 'JS:' && gzip -c dist/waveform-sounds.min.js | wc -c && echo 'CSS:' && gzip -c dist/waveform-sounds.min.css | wc -c",
    "serve": "npx http-server -p 8000",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:pack": "npm run build && node test/pack/verify.mjs",
    "prepublishOnly": "npm test && npm run build",
    "lint": "biome lint",
    "typecheck": "tsc -p ."
  },
  "keywords": [
    "audio",
    "waveform",
    "samples",
    "sample-pack",
    "sound-browser",
    "preview",
    "presets",
    "player",
    "filter",
    "search"
  ],
  "author": "ArrayPress",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WaveformPlayer/waveform-sounds.git"
  },
  "bugs": {
    "url": "https://github.com/WaveformPlayer/waveform-sounds/issues"
  },
  "homepage": "https://github.com/WaveformPlayer/waveform-sounds#readme",
  "engines": {
    "node": ">=22.12"
  },
  "peerDependencies": {
    "@arraypress/waveform-player": "^2.0.0"
  },
  "devDependencies": {
    "@arraypress/text": "^2.2.0",
    "@arraypress/waveform-player": "file:../waveform-player",
    "@biomejs/biome": "^2.6.8",
    "esbuild": "^0.28.2",
    "jsdom": "^31.0.1",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
